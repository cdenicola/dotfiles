# Repair values inherited from shells started before the XDG migration.
[[ ${XDG_DATA_HOME:-} == "$HOME/.config/local/share" ]] && unset XDG_DATA_HOME
[[ ${XDG_CACHE_HOME:-} == "$HOME/.config/cache" ]] && unset XDG_CACHE_HOME
[[ ${NVM_DIR:-} == "$HOME/.config/nvm" ]] && unset NVM_DIR

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

ZDOTDIR="$XDG_CONFIG_HOME/zsh"
typeset +x ZDOTDIR
export NVM_DIR="${NVM_DIR:-$XDG_DATA_HOME/nvm}"
export TMUX_PLUGIN_MANAGER_PATH="${TMUX_PLUGIN_MANAGER_PATH:-$XDG_DATA_HOME/tmux/plugins}"

export EDITOR="nvim"
export VISUAL="nvim"

export HISTFILE="$XDG_STATE_HOME/zsh/history"
export HISTSIZE=10000
export SAVEHIST=10000
